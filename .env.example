# Copy to .env for local development. NEVER commit the real .env file.
PORT=3000
# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/routinepulse?retryWrites=true&w=majority
# Long random string used to sign login tokens, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# OPTIONAL: enables AI quiz generation. Without it the API uses its rule-based generator.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Final PoE (Part 3) ----
# Google Sign-In: the OAuth *Web application* client id (Google Cloud Console > APIs & Services > Credentials).
GOOGLE_WEB_CLIENT_ID=
# Push notifications: the whole Firebase service-account JSON on ONE line (Firebase > Project settings > Service accounts).
FIREBASE_SERVICE_ACCOUNT=
# Shared secret the cron service sends in the x-cron-secret header to trigger reminders.
CRON_SECRET=
# Set to true to also run the reminder check inside the server every minute (only works while the instance is awake).
ENABLE_SCHEDULER=false
